# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
# For local PostgreSQL (default):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=ai_financial_assistant
# DB_SSL=false

# For Aiven PostgreSQL Cloud (production):
DB_HOST=pg-8eb1840-winners.h.aivencloud.com
DB_PORT=14690
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_DATABASE=defaultdb
DB_SSL=true

# JWT Configuration
JWT_SECRET=ai-financial-voice-assistant-jwt-secret-key-2024-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=ai-financial-voice-assistant-jwt-refresh-secret-key-2024
JWT_REFRESH_EXPIRATION=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3001,http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# OTP Configuration
OTP_SECRET=ai-financial-otp-secret-key-2024

# Security
BCRYPT_SALT_ROUNDS=10

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs
